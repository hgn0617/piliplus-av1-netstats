diff --git a/lib/utils/cdn_speed_test.dart b/lib/utils/cdn_speed_test.dart
new file mode 100644
index 0000000..4cbfde7
--- /dev/null
+++ b/lib/utils/cdn_speed_test.dart
@@ -0,0 +1,113 @@
+import 'dart:async';
+import 'dart:math' as math;
+
+import 'package:dio/dio.dart';
+
+enum CdnTestEnd { sizeLimit, timeLimit, endOfStream, error, cancelled }
+
+class CdnSpeedSample {
+  final int bytes;
+  final Duration elapsed;
+  final CdnTestEnd? end;
+  final Object? error;
+
+  const CdnSpeedSample(this.bytes, this.elapsed, {this.end, this.error});
+
+  // Decimal MB/s, consistent with the 5,000,000-byte sample limit.
+  double get megabytesPerSecond =>
+      elapsed.inMicroseconds == 0 ? 0 : bytes / elapsed.inMicroseconds;
+}
+
+/// A streaming sample with a wall-clock deadline including connection time.
+/// The deadline runs independently of incoming data, including stalled streams.
+Future<CdnSpeedSample> measureCdnSpeed({
+  required Dio dio,
+  required String url,
+  required CancelToken cancelToken,
+  void Function(CdnSpeedSample)? onProgress,
+  int maxBytes = 5000000,
+  Duration timeout = const Duration(seconds: 5),
+}) {
+  if (maxBytes <= 0 || timeout <= Duration.zero) {
+    throw ArgumentError('Sample size and timeout must be positive.');
+  }
+  final result = Completer<CdnSpeedSample>();
+  final watch = Stopwatch()..start();
+  StreamSubscription<List<int>>? stream;
+  Timer? deadline;
+  Timer? progress;
+  int received = 0;
+
+  void finish(CdnTestEnd end, [Object? error]) {
+    if (result.isCompleted) return;
+    watch.stop();
+    deadline?.cancel();
+    progress?.cancel();
+    result.complete(
+      CdnSpeedSample(received, watch.elapsed, end: end, error: error),
+    );
+    unawaited(stream?.cancel());
+    if (!cancelToken.isCancelled) cancelToken.cancel('CDN sample finished');
+  }
+
+  deadline = Timer(timeout, () => finish(CdnTestEnd.timeLimit));
+  progress = Timer.periodic(const Duration(milliseconds: 250), (_) {
+    onProgress?.call(CdnSpeedSample(received, watch.elapsed));
+  });
+  unawaited(cancelToken.whenCancel.then((_) => finish(CdnTestEnd.cancelled)));
+
+  Future<void> download() async {
+    try {
+      final response = await dio.get<ResponseBody>(
+        url,
+        cancelToken: cancelToken,
+        options: Options(
+          responseType: ResponseType.stream,
+          headers: {'Range': 'bytes=0-${maxBytes - 1}'},
+        ),
+      );
+      if (result.isCompleted) return;
+      final body = response.data;
+      if (body == null) {
+        finish(CdnTestEnd.error, StateError('Empty response'));
+        return;
+      }
+      stream = body.stream.listen(
+        (chunk) {
+          if (result.isCompleted) return;
+          received = math.min(maxBytes, received + chunk.length);
+          if (received == maxBytes) finish(CdnTestEnd.sizeLimit);
+        },
+        onDone: () => finish(CdnTestEnd.endOfStream),
+        onError: (Object error) => finish(CdnTestEnd.error, error),
+        cancelOnError: true,
+      );
+    } catch (error) {
+      finish(CdnTestEnd.error, error);
+    }
+  }
+
+  unawaited(download());
+  return result.future;
+}
+
+/// Starts the next item as soon as any worker finishes, without batch barriers.
+Future<void> runCdnTestQueue<T>({
+  required List<T> items,
+  required int concurrency,
+  required bool Function() isActive,
+  required Future<void> Function(T) test,
+}) async {
+  if (concurrency <= 0) throw ArgumentError.value(concurrency, 'concurrency');
+  int next = 0;
+  Future<void> worker() async {
+    while (isActive() && next < items.length) {
+      final item = items[next++];
+      await test(item);
+    }
+  }
+
+  await Future.wait(
+    List.generate(math.min(concurrency, items.length), (_) => worker()),
+  );
+}
