+++ b/tool/verify_cdn_speed_test.dart
@@ -0,0 +1,181 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:PiliPlus/utils/cdn_speed_test.dart';
+import 'package:dio/dio.dart';
+
+void check(bool condition, String message) {
+  if (!condition) throw StateError(message);
+}
+
+Future<void> main() async {
+  final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+  final dio = Dio();
+  final ranges = <String, String?>{};
+  server.listen((request) async {
+    ranges[request.uri.path] = request.headers.value('range');
+    final response = request.response;
+    try {
+      switch (request.uri.path) {
+        case '/fast':
+          response.add(Uint8List(5000000));
+        case '/short':
+          response.add(Uint8List(64000));
+        case '/slow':
+          for (int i = 0; i < 70; i++) {
+            response.add(Uint8List(20000));
+            await response.flush();
+            await Future<void>.delayed(const Duration(milliseconds: 100));
+          }
+        case '/stall':
+          response.add(Uint8List(30000));
+          await response.flush();
+          await Future<void>.delayed(const Duration(seconds: 6));
+        case '/silent':
+          await Future<void>.delayed(const Duration(seconds: 6));
+        case '/forbidden':
+          response.statusCode = 403;
+        default:
+          response.statusCode = 404;
+      }
+      await response.close();
+    } catch (_) {
+      // A completed sample intentionally closes the HTTP transfer early.
+    }
+  });
+  String url(String path) => 'http://127.0.0.1:${server.port}$path';
+  final results = <String, Object>{};
+  try {
+    final fast = await measureCdnSpeed(
+      dio: dio,
+      url: url('/fast'),
+      cancelToken: CancelToken(),
+    );
+    check(
+      fast.bytes == 5000000 && fast.end == CdnTestEnd.sizeLimit,
+      'Fast sample must stop at 5 decimal MB.',
+    );
+    check(ranges['/fast'] == 'bytes=0-4999999', 'Range request is bounded.');
+    final short = await measureCdnSpeed(
+      dio: dio,
+      url: url('/short'),
+      cancelToken: CancelToken(),
+    );
+    check(
+      short.bytes == 64000 && short.end == CdnTestEnd.endOfStream,
+      'Short responses must produce a final result.',
+    );
+    int progress = 0;
+    final timed = await Future.wait([
+      measureCdnSpeed(
+        dio: dio,
+        url: url('/slow'),
+        cancelToken: CancelToken(),
+        onProgress: (_) => progress++,
+      ),
+      measureCdnSpeed(dio: dio, url: url('/stall'), cancelToken: CancelToken()),
+      measureCdnSpeed(
+        dio: dio,
+        url: url('/silent'),
+        cancelToken: CancelToken(),
+      ),
+    ]);
+    for (int i = 0; i < timed.length; i++) {
+      final sample = timed[i];
+      check(sample.end == CdnTestEnd.timeLimit, 'Sample $i missed deadline.');
+      check(
+        sample.elapsed.inMilliseconds >= 4850 &&
+            sample.elapsed.inMilliseconds < 5500,
+        'Deadline must be five seconds.',
+      );
+    }
+    check(
+      timed[0].bytes > 200000 && timed[0].bytes < 1400000 && progress >= 16,
+      'Slow download must report live progress and its partial average.',
+    );
+    check(
+      timed[1].bytes == 30000 && timed[1].megabytesPerSecond > 0,
+      'Stalled download must retain bytes for the five-second average.',
+    );
+    check(
+      timed[2].bytes == 0 && timed[2].megabytesPerSecond == 0,
+      'No-response sample must complete with a zero average.',
+    );
+    final forbidden = await measureCdnSpeed(
+      dio: dio,
+      url: url('/forbidden'),
+      cancelToken: CancelToken(),
+    );
+    check(
+      forbidden.end == CdnTestEnd.error &&
+          forbidden.error is DioException &&
+          (forbidden.error! as DioException).response?.statusCode == 403,
+      'HTTP errors must remain distinguishable from a zero download rate.',
+    );
+    final token = CancelToken();
+    final cancelled = measureCdnSpeed(
+      dio: dio,
+      url: url('/slow'),
+      cancelToken: token,
+    );
+    Timer(
+      const Duration(milliseconds: 100),
+      () => token.cancel('Dialog closed'),
+    );
+    final cancelledSample = await cancelled;
+    check(
+      cancelledSample.end == CdnTestEnd.cancelled &&
+          cancelledSample.elapsed.inMilliseconds < 500,
+      'Closing the dialog must cancel active transfers immediately.',
+    );
+
+    for (final limit in [1, 4, 8, 21]) {
+      int active = 0, peak = 0, completed = 0;
+      await runCdnTestQueue(
+        items: List.generate(21, (i) => i),
+        concurrency: limit,
+        isActive: () => true,
+        test: (_) async {
+          active++;
+          if (active > peak) peak = active;
+          await Future<void>.delayed(const Duration(milliseconds: 10));
+          active--;
+          completed++;
+        },
+      );
+      check(peak == limit && completed == 21, 'Incorrect concurrency $limit.');
+    }
+    int started = 0;
+    bool active = true;
+    await runCdnTestQueue(
+      items: List.generate(21, (i) => i),
+      concurrency: 4,
+      isActive: () => active,
+      test: (_) async {
+        started++;
+        await Future<void>.delayed(const Duration(milliseconds: 10));
+        active = false;
+      },
+    );
+    check(started == 4, 'Cancellation must not start queued tests.');
+    results.addAll({
+      'max_bytes': fast.bytes,
+      'deadline_seconds': 5,
+      'slow_partial_bytes': timed[0].bytes,
+      'slow_average_MB_per_second': timed[0].megabytesPerSecond,
+      'stall_partial_bytes': timed[1].bytes,
+      'stall_deadline_ms': timed[1].elapsed.inMilliseconds,
+      'silent_deadline_ms': timed[2].elapsed.inMilliseconds,
+      'live_progress_updates': progress,
+      'short_response_and_http_403': 'passed',
+      'cancel_active_and_queued': 'passed',
+      'concurrency_1_4_8_21': 'passed',
+    });
+    stdout.writeln(const JsonEncoder.withIndent('  ').convert(results));
+  } finally {
+    dio.close(force: true);
+    await server.close(force: true);
+  }
+}
